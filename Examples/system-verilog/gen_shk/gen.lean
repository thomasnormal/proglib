import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_shk`: shifts of a genvar by a literal amount, as `sv_comb` test subjects

`m >> k` and `(m >> k) << k` of a named constant `m` and an integer literal `k ∈ [0, 32)` are the atoms `shrK m k`
(`m / 2 ^ k`) and `shlK m k` (`m / 2 ^ k * 2 ^ k`) of the affine reading (`xatOf?`, CombView.lean), owed in their range
(`XAt.Ok`: `0 ≤ m < 2^31`, IEEE 1800-2023 §11.4.10's logical shift of a non-negative value), like the shifts by a name.

* `gen_shk.sv`: `s[i] = a[(i >> 1) << 1] ^ b[i]` (an index) and `if ((i >> 2) == 0)` (a generate condition) with
  `t[i] = b[i >> 2]` in its other arm;
* `neg/gen_shk_wide.sv`: `a[i >> 40]`, an amount of 32 or more: not an atom, refused (`comb_errors`).

Oracle: Icarus Verilog 12.0 (stable), a testbench outside the repository (`tb_shk.sv`), every input at `N = 1..4`
(340 rows): its `s` and `t` agree with `shkSpec` below on every row; `shkExhaustive` checks the model against `shkSpec`.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_shk/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_shk.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_shk from "Examples/system-verilog/gen_shk/gen_shk.sv.json"
load_design_sv2 gen_shk_wide from "Examples/system-verilog/gen_shk/neg/gen_shk_wide.sv.json"

-- The accesses' atoms: `(i >> 1) << 1` and `i >> 2` are the literal-amount atoms.
#guard (gen_shk.pdesign.summary.toOption.map fun s => s.lsites.map fun ls =>
    (ls.site.tgt.name, ls.site.rds.map Acc.name)) ==
  some [("s", ["a", "b"]), ("t", ["a"]), ("t", ["b"])]

/-- `s` and `t` of `gen_shk` at width `N` for the inputs `a`, `b` (the values Icarus prints). -/
def shkSpec (N a b : Nat) : Nat × Nat :=
  let bit (x i : Nat) := x / 2 ^ i % 2
  ((List.range N).foldl (fun acc i => acc + (Nat.xor (bit a (i / 2 * 2)) (bit b i)) * 2 ^ i) 0,
   (List.range N).foldl (fun acc i => acc + (if i / 4 = 0 then bit a i else bit b (i / 4)) * 2 ^ i) 0)

/-- Every input at width `N` (a test, evaluated by the compiler). -/
def shkExhaustive (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (2 * N))).all fun k =>
    let a := k % 2 ^ N
    let b := k / 2 ^ N
    match run2 (gen_shk.sem N) σ 64 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b)]] with
    | .ok [st] =>
        SvState.lookup st "s" == some (LVec.ofNat N (shkSpec N a b).1) &&
          SvState.lookup st "t" == some (LVec.ofNat N (shkSpec N a b).2)
    | _ => false

#guard [1, 2, 3, 4].all (shkExhaustive σ_src)
#guard [1, 2, 3, 4].all (shkExhaustive σ_rev)

end Examples.«system-verilog».gen_shk.gen
