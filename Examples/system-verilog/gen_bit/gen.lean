import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_bit`: the bit test of two genvars, as `sv_comb` test subjects

`((i >> l) & 1) == 1` is read as a guard on the BIT ATOM `i / 2 ^ l % 2` (`XAt.bit "i" "l"`), and `((i >> l) << l) - 1`
in an index as the atom `i / 2 ^ l * 2 ^ l` (`XAt.shl "i" "l"`) minus one. The instantiation evaluates the condition at
the signed 32-bit type (`evalGenGuard`) and the index over the integers (`evalInt`); both agree with the atoms' values,
and with IEEE 1800-2023's 32-bit `int` meaning (§11.4.8, §11.4.10), exactly where the atoms are in their range
(`XAt.Ok`: `0 ≤ i < 2^31`, `0 ≤ l < 32`), an obligation (`Summary.XObl`).

* `gen_bit.sv`: a Sklansky-style OR prefix, `L = $clog2(N)` levels;
* `neg/gen_bit_two.sv`: `((i >> l) & 2) == 2`: only `& 1` is the bit atom, refused;
* `neg/gen_bit_sum.sv`: `(i + 1) >> 1` in an index: a shift of a sum (or by a literal) is not an atom, refused.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_bit/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_bit.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_bit from "Examples/system-verilog/gen_bit/gen_bit.sv.json"
load_design_sv2 gen_bit_two from "Examples/system-verilog/gen_bit/neg/gen_bit_two.sv.json"
load_design_sv2 gen_bit_sum from "Examples/system-verilog/gen_bit/neg/gen_bit_sum.sv.json"

-- The located sites and the guards of their arms; the atoms of the condition and of the read index.
#guard (gen_bit.pdesign.summary.toOption.map fun s => s.lsites.map fun ls =>
    (ls.blk, ls.site.pos, ls.hdrs.map fun h => (h.g, h.gs.map (·.2)))) ==
  some [("g_in", 0, [("i", [])]), ("g_node", 0, [("l", []), ("i", [true])]),
        ("g_node", 1, [("l", []), ("i", [false])]), ("g_out", 0, [("i", [])])]
#guard (gen_bit.pdesign.summary.toOption.map fun s =>
    (s.condSteps.map fun c => (c.2.2.a.xs, c.2.2.b), s.lsites.map fun ls => ls.site.rds.map fun r => r.affs.map (·.xs))) ==
  some ([([(1, .bit "i" "l")], Aff.const 1)],
    [[[[]]], [[[], []], [[], [(1, .shl "i" "l")]]], [[[], []]], [[[], []]]])

-- The instantiation at `N = 9` (`L = 4`) builds 9 + 4 * 9 + 9 processes: the closed-form list has the same length.
#guard ((gen_bit.pdesign.instantiate2 [9] (PDesign.surfaceFuel [9])).toOption.map fun m => m.processes.size) == some 54
#guard (gen_bit.pdesign.summary.toOption.map fun s => (s.insts (s.val [9])).length) == some 54

-- The arm the instantiation selects (`evalGenGuard` of `((i >> l) & 1) == 1`, `N = 9`), the summary's guard, and the
-- index `((i >> l) << l) - 1` where the arm is the `then` one (`evalInt`, and the summary's form), against the values
-- Icarus Verilog 13.0 prints (tb_pow.sv: `bit l=… i=… <arm> <index>`), for `l < 3`, `i < 9`.
#guard (gen_bit.pdesign.summary.toOption.bind fun s => (gen_bit.pdesign.paramEnv2 [9]).toOption.bind fun e =>
    match s.condSteps, s.lsites with
    | [(_, c, g)], [_, op, _, _] =>
        match op.site.rds with
        | [_, .cell2 _ _ _ k] =>
            some (([0, 1, 2] : List Int).map fun l => ([0, 1, 2, 3, 4, 5, 6, 7, 8] : List Int).filterMap fun i =>
              let E := (e.bindVal "l" l).bindVal "i" i
              let σ := bindσ "i" i (bindσ "l" l (s.val [9]))
              if decide (g.holds σ) then
                some ((evalGenGuard E c).toOption, (evalInt E (.binary (.m0 .sub) (.binary .shl (.binary .shr
                  (.genvarRef "i") (.genvarRef "l")) (.genvarRef "l")) (.int 1))).toOption, k.eval σ)
              else none)
        | _ => none
    | _, _ => none) ==
  some [[(some 1, some 0, 0), (some 1, some 2, 2), (some 1, some 4, 4), (some 1, some 6, 6)],
    [(some 1, some 1, 1), (some 1, some 1, 1), (some 1, some 5, 5), (some 1, some 5, 5)],
    [(some 1, some 3, 3), (some 1, some 3, 3), (some 1, some 3, 3), (some 1, some 3, 3)]]
-- … and where the guard fails, the instantiation selects the `else` arm (`0`), at the same points Icarus does.
#guard (gen_bit.pdesign.summary.toOption.bind fun s => (gen_bit.pdesign.paramEnv2 [9]).toOption.bind fun e =>
    match s.condSteps with
    | [(_, c, g)] =>
        some (([0, 1, 2] : List Int).map fun l => ([0, 1, 2, 3, 4, 5, 6, 7, 8] : List Int).map fun i =>
          ((evalGenGuard ((e.bindVal "l" l).bindVal "i" i) c).toOption,
            decide (g.holds (bindσ "i" i (bindσ "l" l (s.val [9]))))))
    | _ => none) ==
  some [[(some 0, false), (some 1, true), (some 0, false), (some 1, true), (some 0, false), (some 1, true),
      (some 0, false), (some 1, true), (some 0, false)],
    [(some 0, false), (some 0, false), (some 1, true), (some 1, true), (some 0, false), (some 0, false),
      (some 1, true), (some 1, true), (some 0, false)],
    [(some 0, false), (some 0, false), (some 0, false), (some 0, false), (some 1, true), (some 1, true),
      (some 1, true), (some 1, true), (some 0, false)]]

end Examples.«system-verilog».gen_bit.gen
