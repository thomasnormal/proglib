import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_repa`: a replication count with a shift atom, as an `sv_comb` test subject

`{(P >> l){a[0]}}`, `{(P - (P >> l)){a[N-1]}}`: the count of a replication is read by the affine reading with its
shift and power atoms (`repRd?`;
before a count was read atom-free and this was refused), the atoms' ranges owed by `Summary.XObl` with every other
atom of the design, the count's non-negativity by `InRangeObl`.

* `gen_repa.sv`: row `l - 1` of `v` (`4N` bits) takes `P >> l` copies of `a[0]` (`P = 4N`: `2N`, then `N` bits), and
  the rest of the row copies of `a[N-1]`.

Oracle: Icarus Verilog 12.0 (stable), a testbench outside the repository (`tb_repa.sv`), every input at `N = 1..5` (62
rows): its `v` agrees with `repaSpec` below on every row; `repaCheck` checks the model against `repaSpec`.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_repa Examples/system-verilog/gen_repa/gen_repa.sv -o gen_repa.sv.json`.
-/

namespace Examples.«system-verilog».gen_repa.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_repa from "Examples/system-verilog/gen_repa/gen_repa.sv.json"

-- the replication's count is read, with its shift atom
#guard (gen_repa.pdesign.summary.toOption.map fun s => (s.lsites.map fun ls => ls.site.rcounts.map (·.xs.length)).flatten) ==
  some [1, 1]

/-- `v` of `gen_repa` at width `N` (rows of `4N` bits, row 0 low) for the input `a` (the value Icarus prints). -/
def repaSpec (N a : Nat) : Nat :=
  let lo := a % 2
  let hi := a / 2 ^ (N - 1) % 2
  let row (S : Nat) := (List.range (4 * N)).foldl (fun acc i => acc + (if i < S then lo else hi) * 2 ^ i) 0
  row (2 * N) + row N * 2 ^ (4 * N)

/-- Every input at width `N` (a test, evaluated by the compiler). -/
def repaCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a =>
    match run2 (gen_repa.sem N) σ 64 [[("a", LVec.ofNat N a)]] with
    | .ok [st] => SvState.lookup st "v" == some (LVec.ofNat (8 * N) (repaSpec N a))
    | _ => false

#guard [1, 2, 3, 4, 5].all (repaCheck σ_src)
#guard [1, 2, 3, 4, 5].all (repaCheck σ_rev)

end Examples.«system-verilog».gen_repa.gen
