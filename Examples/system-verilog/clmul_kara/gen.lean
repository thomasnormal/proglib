import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `clmul_kara`: the svGolf `clmul` record built as a Karatsuba recursion, as an `sv_comb` test subject

The design (`clmul_kara.sv`, the svGolf record verbatim, its header kept) multiplies two `N`-bit polynomials over GF(2):
the operands are zero-padded to `P = 4·2^L` bits (`L = $clog2((N + 3) / 4)`), level `l` holds `3^l` nodes of width
`P >> l` in the rows `av[l]`, `bv[l]` (top down: each node's halves and their XOR are its three children), the base
level multiplies 4 x 4 bits by schoolbook, and the products are combined bottom up in the rows `rv[l]`, node `t` of level
`l` in the slot `t·2·(P >> l)`. Every index is a product of a genvar and a slot width `P >> l`: the coverage goals of
its equations are the ones the slot-window rule of `sv_cover` reads (`LeanModels/Sv/CombCoverUnit.lean`).

`karaCheck` checks the model against the carry-less product `clmulNat` at `N = 1..3` (one level, `L = 0`) under both
schedule oracles and at `N = 5` (two levels, `L = 1`) under the source-order oracle: every input pair. No simulator
result is claimed here (the round that added the example ran none).

The envelope was generated by
`python3.12 extractors/sv/extract.py --top clmul_n Examples/system-verilog/clmul_kara/clmul_kara.sv -o Examples/system-verilog/clmul_kara/clmul_kara.sv.json`.
-/

namespace Examples.«system-verilog».clmul_kara.gen

open LeanModels.Sv LeanModels.Sv.CombView

set_option maxRecDepth 100000 in
load_design_sv2 clmul_kara from "Examples/system-verilog/clmul_kara/clmul_kara.sv.json"

/-- The carry-less product of two naturals (the XOR of the shifted copies of `b` for the set bits of `a`). -/
def clmulNat (a b : Nat) : Nat :=
  (List.range (Nat.log2 a + 1)).foldl (fun acc i => if a.testBit i then acc ^^^ (b <<< i) else acc) 0

/-- Every input pair at width `N` (a test, evaluated by the compiler): `p` is the carry-less product. -/
def karaCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a => (List.range (2 ^ N)).all fun b =>
    match run2 (clmul_kara.sem N) σ 256 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b)]] with
    | .ok [st] => SvState.lookup st "p" == some (LVec.ofNat (2 * N - 1) (clmulNat a b))
    | _ => false

#guard [1, 2, 3, 5].all (karaCheck σ_src)
#guard [1, 2, 3].all (karaCheck σ_rev)

end Examples.«system-verilog».clmul_kara.gen
