import LeanModels.Sv.Ingest2
import LeanModels.Sv.CombExhaustiveTactic
import Examples.«system-verilog».comb_exh.statement

/-!
# `sv_exhaustive` run to success: a table design and a gate design (comb_exh)

Two fixed-size tasks in svGolf's vocabulary (`statement.lean`), each proved by `sv_exhaustive` alone:

* `popTask` on `comb_exh_table.sv` (one `always_comb` with a `case` of 16 constant items): `y` is the number of ones of
  the 4-bit `x`, the function written by counting bits (not by a table). The tactic's `always_comb` route: the design is
  read through its lowering (`CombTask.satisfiedAt_of_lowered`), the `case` compiles to a word-level table lookup.
* `faTask` on `comb_exh_gates.sv` (a full adder of continuous assigns): two outputs `s`, `cout` against `Nat` sums. The
  continuous-assign route (`CombTask.satisfiedAt_of_comb`), one decision per output.

Oracle: Icarus Verilog 12.0 (stable), every input of both designs (16 and 8 rows; the round's notes,
`tac8/icarus/tb_exh.sv`): each row agrees with the functions below. The `#guard`s run the designs under `run2` against the
same functions.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top comb_exh_table Examples/system-verilog/comb_exh/comb_exh_table.sv -o Examples/system-verilog/comb_exh/comb_exh_table.sv.json`
(and the same for `comb_exh_gates`, `comb_exh_bad`).
-/

namespace Examples.«system-verilog».comb_exh.exh_proof

open LeanModels.Sv
open Examples.«system-verilog».comb_exh.statement

load_design_sv2 comb_exh_table from "Examples/system-verilog/comb_exh/comb_exh_table.sv.json"
load_design_sv2 comb_exh_gates from "Examples/system-verilog/comb_exh/comb_exh_gates.sv.json"

/-- The number of ones of a 4-bit vector, counted bit by bit. -/
def pop4 (x : BitVec 4) : BitVec 3 :=
  BitVec.ofNat 3 ((List.range 4).countP fun i => x.getLsbD i)

/-- The table task: `x` (4 bits) in, `y = pop4 x` (3 bits) out. -/
def popTask : SvGolf.CombTask where
  inRange N := N = 0
  inputs _ := [("x", 4)]
  outputs _ := [("y", 3)]
  fn _ := fun (x, ()) => (pop4 x, ())

/-- The full-adder task: `a`, `b`, `cin` (1 bit each) in, `s` and `cout` (the low and high bit of the sum) out. -/
def faTask : SvGolf.CombTask where
  inRange N := N = 0
  inputs _ := [("a", 1), ("b", 1), ("cin", 1)]
  outputs _ := [("s", 1), ("cout", 1)]
  fn _ := fun (a, b, c, ()) =>
    (BitVec.ofNat 1 (a.toNat + b.toNat + c.toNat), BitVec.ofNat 1 ((a.toNat + b.toNat + c.toNat) / 2), ())

/-! The designs under `run2`, every input, against the functions (tests, evaluated by the compiler). -/

#guard (List.range 16).all fun x =>
  match run2 comb_exh_table.sem σ_src 64 [[("x", LVec.ofNat 4 x)]] with
  | .ok [st] => SvState.lookup st "y" == some (LVec.ofBitVec (pop4 (BitVec.ofNat 4 x)))
  | _ => false

#guard (List.range 8).all fun k =>
  match run2 comb_exh_gates.sem σ_rev 64
      [[("a", LVec.ofNat 1 (k % 2)), ("b", LVec.ofNat 1 (k / 2 % 2)), ("cin", LVec.ofNat 1 (k / 4))]] with
  | .ok [st] => SvState.lookup st "s" == some (LVec.ofNat 1 ((k % 2 + k / 2 % 2 + k / 4) % 2)) &&
      SvState.lookup st "cout" == some (LVec.ofNat 1 ((k % 2 + k / 2 % 2 + k / 4) / 2))
  | _ => false

/-! The statements, by `sv_exhaustive`. -/

/-- **The table design computes the number of ones** (the `always_comb` route of `sv_exhaustive`). -/
theorem table_ok : popTask.StatementFixed comb_exh_table.sem := by
  sv_exhaustive

/-- **The gate design is a full adder** (the continuous-assign route, two outputs). -/
theorem gates_ok : faTask.StatementFixed comb_exh_gates.sem := by
  sv_exhaustive

/-- info: 'Examples.«system-verilog».comb_exh.exh_proof.table_ok' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms table_ok

/-- info: 'Examples.«system-verilog».comb_exh.exh_proof.gates_ok' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms gates_ok

end Examples.«system-verilog».comb_exh.exh_proof
