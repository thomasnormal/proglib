import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `mul_dadda`: the svGolf `mul` record built as a Dadda tree, as an `sv_comb` test subject

The design (`mul_dadda.sv`, the svGolf record verbatim, its header kept) reduces the partial products of an `N`-bit
multiplier column by column with full and half adders down to two rows, then adds them with a ripple-carry adder. Its
schedule is written into the generate expressions: the stage count `S` is a localparam summing 51 `?:` (the Dadda heights
below `N`), the target height of a stage is a 51-leaf `?:` table, and five one-iteration loops name a stage's or a column's
numbers through `?:` starts.

Oracle: Icarus Verilog 12.0 (stable), the round's bench `tb_dadda.sv`, every input pair at `N = 1..5` (1364 rows): `p` is
`a * b` on every row; `daddaCheck` checks the model against the same at `N = 1..3`.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top mul_n Examples/system-verilog/mul_dadda/mul_dadda.sv -o Examples/system-verilog/mul_dadda/mul_dadda.sv.json`.
-/

namespace Examples.«system-verilog».mul_dadda.gen

open LeanModels.Sv LeanModels.Sv.CombView

set_option maxRecDepth 100000 in
load_design_sv2 mul_dadda from "Examples/system-verilog/mul_dadda/mul_dadda.sv.json"

-- the summary: 20 located sites, two localparams (the stage count `S` and `NP`)
#guard (mul_dadda.pdesign.summary.toOption.map fun s => (s.lsites.length, s.lps.length)) == some (20, 2)

/-- Every input pair at width `N` (a test, evaluated by the compiler): `p = a * b`. -/
def daddaCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a => (List.range (2 ^ N)).all fun b =>
    match run2 (mul_dadda.sem N) σ 256 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b)]] with
    | .ok [st] => SvState.lookup st "p" == some (LVec.ofNat (2 * N) (a * b))
    | _ => false

#guard [1, 2, 3].all (daddaCheck σ_src)
#guard [1, 2, 3].all (daddaCheck σ_rev)

end Examples.«system-verilog».mul_dadda.gen
