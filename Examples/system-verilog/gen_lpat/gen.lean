import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_lpat`: a localparam that sums `?:`, as an `sv_comb` test subject

`S = ((N > 2) ? 1 : 0) + ((N > 4) ? 1 : 0) + ((N > 6) ? 1 : 0)` (the form of the Dadda record's stage count, there a sum
of 51 such terms) is a loop bound and a loop start: `y[i] = a[N - 1 - i]` for `i < S`, `y[i] = a[i]` from `S` on. Read
with `set_option sv_comb.lp_atoms true` (`comb_proof.lean`), `S` is one variable of the obligations with its definition
the hypothesis `hlp_S`, instead of a copy of the sum wherever it is read; the parameter stage places each partial sum in
the 32-bit range from the bounds of its `?:` (`addIteFacts`).

Oracle: Icarus Verilog 12.0 (stable), the round's bench `tb_lpat.sv`, every input at `N = 1..8` (510 rows): `y` is the
formula of `lpatSpec` on every row; `lpatCheck` checks the model against the same.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_lpat Examples/system-verilog/gen_lpat/gen_lpat.sv -o Examples/system-verilog/gen_lpat/gen_lpat.sv.json`.
-/

namespace Examples.«system-verilog».gen_lpat.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_lpat from "Examples/system-verilog/gen_lpat/gen_lpat.sv.json"

-- both loops are read, the second with the localparam as its start
#guard (gen_lpat.pdesign.summary.toOption.map fun s => s.lsites.length) == some 2

/-- `y` of `gen_lpat` at width `N` for the input `a` (the value Icarus prints). -/
def lpatSpec (N a : Nat) : Nat :=
  let S := (if 2 < N then 1 else 0) + (if 4 < N then 1 else 0) + (if 6 < N then 1 else 0)
  (List.range N).foldl (fun acc i => acc + (a / 2 ^ (if i < S then N - 1 - i else i) % 2) * 2 ^ i) 0

/-- Every input at width `N` (a test, evaluated by the compiler). -/
def lpatCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a =>
    match run2 (gen_lpat.sem N) σ 64 [[("a", LVec.ofNat N a)]] with
    | .ok [st] => SvState.lookup st "y" == some (LVec.ofNat N (lpatSpec N a))
    | _ => false

#guard [1, 2, 3, 4, 5, 6, 7, 8].all (lpatCheck σ_src)
#guard [1, 2, 3, 4, 5, 6, 7, 8].all (lpatCheck σ_rev)

end Examples.«system-verilog».gen_lpat.gen
