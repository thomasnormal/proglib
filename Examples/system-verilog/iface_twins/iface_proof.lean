import LeanModels.Sv.Ingest2
import LeanModels.Sv.Comb2
import LeanModels.Sv.CombTaskTactic
import LeanModels.Sv.CombProcTactic

/-!
# `sv_interface` through the twins: the four stages on a signed design and on two designs with module instances

`sv_structure` and `sv_equations` read a design with signed reads through its unsigned twin (`CombSigned.lean`) and a
design with module instances at module level through its flat twin (`CombHier.lean`). `sv_interface` reads both too:
the unsigned twin has the design's declarations (`CombEq.decls_view_unsign`), and the ports of a hierarchical
instantiation are the parent's, every child declaration being hoisted with its port flags cleared
(`CombHier.instantiateHDAlias2_decls`).
Neither needs an obligation of the bridge to the twin. So each design below meets a task statement in the shape of
`CombTask.of_comb` (the ports, no clocked process, the design its own lowering with a rank, termination, and its
function in every cycle) by the four stages: `sv_structure`, `sv_interface`, `sv_equations`, `sv_obligations`.

The designs are clean-room repros, verbatim:

* `signed_select.sv` (`signed_bit_select.sv`): `y = x[0]` of a signed input; a select is an unsigned value
  (IEEE 1800-2023 §11.8.1);
* `unbound_child.sv` (`unbound_child_parameter.sv`): a leaf whose width parameter the parent does not override (§23.3.3,
  the child at its default `A_WIDTH = 8`): `y = x`;
* `halves_param.sv` (`hierarchy_parameterized.sv`): two leaves over the halves of the word, their width overridden by
  `W/2`: `y = a` at every even `W ≥ 2`. The parameter is `W` itself and `W % 2 = 0` a hypothesis: the structure
  stage's sampler skips the odd widths the hypothesis excludes (`pointExcluded`; at `W = 3` the high leaf's port is
  narrower than its actual, a genuine violation there), and `sv_obligations` closes the flat twin's one-driver goal
  (`driverDisjoint`).

Oracle: Icarus Verilog 12.0 (stable), a testbench outside the repository (`tb_iface_twins.sv`): `signed_select` and
`unbound_child` at all 256 inputs, `halves_param` at `W = 2, 4, 6, 8` at all `2^W` inputs: every output agrees with the
statements below.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <top> Examples/system-verilog/iface_twins/<file>.sv -o <file>.sv.json`.
-/

open LeanModels.Sv LeanModels.Sv.CombView LeanModels.Sv.CombEq

namespace Examples.«system-verilog».iface_twins.iface_proof

load_design_sv2 signed_select from "Examples/system-verilog/iface_twins/signed_select.sv.json"
load_design_sv2 unbound_child from "Examples/system-verilog/iface_twins/unbound_child.sv.json"
load_design_sv2 halves_param from "Examples/system-verilog/iface_twins/halves_param.sv.json"

-- Runs: `x = 0xA5` (bit 0 set), `x = 0x5A`; `x = 0x3C` through the leaf; `a = 0b10110100` at `W = 8`.
#guard (match run2 signed_select.sem σ_src 64 [[("x", .ofNat 8 0xA5)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "1"
  | _ => false)
#guard (match run2 signed_select.sem σ_src 64 [[("x", .ofNat 8 0x5A)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "0"
  | _ => false)
#guard (match run2 unbound_child.sem σ_src 64 [[("x", .ofNat 8 0x3C)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "00111100"
  | _ => false)
#guard (match run2 (halves_param.sem 8) σ_src 64 [[("a", .ofNat 8 0xB4)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "10110100"
  | _ => false)

/-! ## 1. A design with signed reads: `y = x[0]` -/

theorem signed_select_struct : CombDesign signed_select.sem ∧ Acyclic signed_select.sem := by
  sv_structure (rank := rippleRank (fun p => p) (fun _ _ _ => 0))
  all_goals (intros; omega)

/-- The ports, read through the unsigned twin. -/
theorem signed_select_ports (hc : CombDesign signed_select.sem) :
    signed_select.sem.inputPorts = [("x", 8)] ∧ signed_select.sem.outputPorts = [("y", 1)] := by
  sv_interface

theorem signed_select_spec :
    (signed_select.sem.inputPorts = [("x", 8)] ∧ signed_select.sem.outputPorts = [("y", 1)]) ∧
      ((∀ p ∈ signed_select.sem.processes.toList, p.isEdgePhase = false) ∧
        (∃ d', signed_select.sem.lowerComb = some d' ∧ Acyclic d') ∧ Terminates2 signed_select.sem) ∧
      signed_select.sem ⊨₂ spec2 fun stim tr => ∀ (c : Nat) (inputs st : SvState),
        stim[c]? = some inputs → tr[c]? = some st →
        ∀ (x : BitVec 8), SvState.lookup inputs "x" = some (LVec.ofBitVec x) →
          SvState.lookup st "y" = some (LVec.ofBitVec (BitVec.ofBool (x.getLsbD 0))) := by
  obtain ⟨hc, ha⟩ := signed_select_struct
  refine CombTask.of_comb hc ha (signed_select_ports hc) fun inputs st heqs hsh hin => ?_
  intro x hx
  sv_inputs
  sv_equations
  · rw [SvState.port_ofBool known_y_plain_0 rfl, eq_y_plain_0, bit_x 0 (by omega)]
  sv_obligations

/-! ## 2. A child at its default width: `y = x` -/

theorem unbound_child_struct : CombDesign unbound_child.sem ∧ Acyclic unbound_child.sem := by
  sv_structure (rank := rippleRank (fun p => if p = 1 then 2 else if p = 2 then 1 else 0) (fun _ _ _ => 0))
  all_goals (intros; omega)

/-- The ports: the parent's (the child's `a`, `y` are hoisted as internal signals). -/
theorem unbound_child_ports (hc : CombDesign unbound_child.sem) :
    unbound_child.sem.inputPorts = [("x", 8)] ∧ unbound_child.sem.outputPorts = [("y", 8)] := by
  sv_interface

theorem unbound_child_spec :
    (unbound_child.sem.inputPorts = [("x", 8)] ∧ unbound_child.sem.outputPorts = [("y", 8)]) ∧
      ((∀ p ∈ unbound_child.sem.processes.toList, p.isEdgePhase = false) ∧
        (∃ d', unbound_child.sem.lowerComb = some d' ∧ Acyclic d') ∧ Terminates2 unbound_child.sem) ∧
      unbound_child.sem ⊨₂ spec2 fun stim tr => ∀ (c : Nat) (inputs st : SvState),
        stim[c]? = some inputs → tr[c]? = some st →
        ∀ (x : BitVec 8), SvState.lookup inputs "x" = some (LVec.ofBitVec x) →
          SvState.lookup st "y" = some (LVec.ofBitVec x) := by
  obtain ⟨hc, ha⟩ := unbound_child_struct
  refine CombTask.of_comb hc ha (unbound_child_ports hc) fun inputs st heqs hsh hin => ?_
  intro x hx
  sv_inputs
  sv_equations
  · have e : Int.natAbs 7 + 1 = 8 := rfl
    simp only [e] at eq_y_1 known_y_1 eq_u_leaf_y_1 eq_u_leaf_a_1
    rw [SvState.port_ofBitVec known_y_1 rfl (by omega)]
    congr 2
    apply BitVec.eq_of_getLsbD_eq
    intro i hi
    rw [XF.getLsbD_bv hi, eq_y_1 i hi, eq_u_leaf_y_1 i hi, eq_u_leaf_a_1 i hi, bit_x i hi]
  sv_obligations

/-! ## 3. Two halves overridden by `W/2`: `y = a` at every even `W` -/

theorem halves_param_struct (W : Nat) (hW : 2 ≤ W) (hWe : W % 2 = 0) (hR : (W : Int) < 2147483647) :
    CombDesign (halves_param.sem W) ∧ Acyclic (halves_param.sem W) := by
  sv_structure (rank := rippleRank (fun p => if p % 3 = 1 then 2 else if p % 3 = 2 then 1 else 0) (fun _ _ _ => 0))
  all_goals (intros; omega)

theorem halves_param_ports (W : Nat) (hW : 2 ≤ W) (hR : (W : Int) < 2147483647)
    (hc : CombDesign (halves_param.sem W)) :
    (halves_param.sem W).inputPorts = [("a", W)] ∧ (halves_param.sem W).outputPorts = [("y", W)] := by
  sv_interface

theorem halves_param_spec (W : Nat) (hW : 2 ≤ W) (hWe : W % 2 = 0) (hR : (W : Int) < 2147483647) :
    ((halves_param.sem W).inputPorts = [("a", W)] ∧ (halves_param.sem W).outputPorts = [("y", W)]) ∧
      ((∀ p ∈ (halves_param.sem W).processes.toList, p.isEdgePhase = false) ∧
        (∃ d', (halves_param.sem W).lowerComb = some d' ∧ Acyclic d') ∧ Terminates2 (halves_param.sem W)) ∧
      halves_param.sem W ⊨₂ spec2 fun stim tr => ∀ (c : Nat) (inputs st : SvState),
        stim[c]? = some inputs → tr[c]? = some st →
        ∀ (a : BitVec W), SvState.lookup inputs "a" = some (LVec.ofBitVec a) →
          SvState.lookup st "y" = some (LVec.ofBitVec a) := by
  obtain ⟨hc, ha⟩ := halves_param_struct W hW hWe hR
  refine CombTask.of_comb hc ha (halves_param_ports W hW hR hc) fun inputs st heqs hsh hin => ?_
  intro a hA
  sv_inputs
  sv_equations
  · -- the widths: each half is `W / 2` bits
    obtain ⟨K, rfl⟩ : ∃ K, W = 2 * K := ⟨W / 2, by omega⟩
    have e1 : ((↑(2 * K) : Int) / 2 + -1).natAbs + 1 = K := by omega
    have e2 : (-1 + (↑(2 * K) : Int) / 2 + 1).toNat = K := by omega
    have e3 : ((↑(2 * K) : Int) / 2).toNat = K := by omega
    have e4 : ((↑(2 * K) : Int) + -1 - ↑(2 * K) / 2 + 1).toNat = K := by omega
    have e5 : ((↑(2 * K) : Int) + -1).natAbs + 1 = 2 * K := by omega
    simp only [e1, e2, e3, e4, e5] at eq_lo_a_1 eq_lo_y_1 eq_hi_a_1 eq_hi_y_1 eq_y_1 eq_y_2 known_y_1 known_y_2
    have hk : ∀ k, k < 2 * K → (∃ w, SvState.lookup st "y" = some w ∧ w.width = 2 * K) ∧ KnownBit st "y" k := by
      intro k hk
      by_cases h : k < K
      · exact known_y_1 k h
      · have := known_y_2 (k - K) (by omega)
        rwa [Nat.add_sub_cancel' (by omega)] at this
    rw [SvState.port_ofBitVec hk rfl (by omega)]
    congr 2
    apply BitVec.eq_of_getLsbD_eq
    intro i hi
    rw [XF.getLsbD_bv hi]
    by_cases h : i < K
    · -- the low half, through the leaf `lo`
      rw [eq_y_1 i h, eq_lo_y_1 i h, eq_lo_a_1 i h, bit_a i hi]
    · -- the high half, through the leaf `hi`
      obtain ⟨j, rfl⟩ : ∃ j, i = K + j := ⟨i - K, by omega⟩
      rw [eq_y_2 j (by omega), eq_hi_y_1 j (by omega), eq_hi_a_1 j (by omega), bit_a (K + j) hi]
  sv_obligations

/-! ## Axioms -/

/--
info: 'Examples.«system-verilog».iface_twins.iface_proof.signed_select_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms signed_select_spec

/--
info: 'Examples.«system-verilog».iface_twins.iface_proof.unbound_child_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms unbound_child_spec

/--
info: 'Examples.«system-verilog».iface_twins.iface_proof.halves_param_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms halves_param_spec

end Examples.«system-verilog».iface_twins.iface_proof
