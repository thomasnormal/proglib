import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_d3s`: selects of a three-dimensional packed array, as an `sv_comb` test subject (tac8)

A plane `T[0]`, rows `T[s][k]`, parts of rows `U[s][k][1:0]`, `U[s][k][3:2]`, `T[s][k][3:2]`, cells `U[N-1][k][i]` and
a whole-plane read `U[N-1]` of the 3-D declarations `logic [N-1:0][2:0][3:0] T, U` (`Acc.plane3`, `row3`, `part3`,
`cell3`, tac8; until tac8 every select of a 3-D declaration was refused). The flat offset of `T[s][k][i]` is the nested
row-major `rmN 4 (rmN 3 s k) i`.

* `gen_d3s.sv`: `T[0]` is the low plane of `a`; plane `s` of `T` is plane `s - 1` XOR plane `s` of `a`, row by row; `U[s][k]`
  is row `k` of `T[s]` with its halves swapped; `z` is the last plane of `U` XOR the first of `T`, cell by cell; `q` is the
  last plane of `U`.

* `gen_d3p.sv`: whole planes `T[0]`, `T[1]` of `logic [1:0][N-1:0][2:0] T` (a parameter in the middle dimension; the
  envelope's legacy select over a 3-D declaration, one `elemW`-bit chunk: a plane), and one cell `T[1][N-1][2]`, so `y` is
  bit `3(N-1) + 2` of `a`.

Oracle: Icarus Verilog 12.0 (stable), `tac8/icarus/tb_d3s.sv` of the round's notes, 4096 inputs at each of `N = 1, 2, 3`
(12288 rows): its `z` and `q` agree with `d3sSpec` below on every row; `d3sCheck` checks the model against `d3sSpec`.
`tac8/icarus/tb_d3p.sv`, every input of `gen_d3p` at `N = 1..4` (4680 rows): `y` is that bit of `a` on every row;
`d3pCheck` checks the model against the same.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top gen_d3s Examples/system-verilog/gen_d3s/gen_d3s.sv -o Examples/system-verilog/gen_d3s/gen_d3s.sv.json`
(and the same for `gen_d3p`).
-/

namespace Examples.«system-verilog».gen_d3s.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_d3s from "Examples/system-verilog/gen_d3s/gen_d3s.sv.json"
load_design_sv2 gen_d3p from "Examples/system-verilog/gen_d3s/gen_d3p.sv.json"

-- every select of `T` and `U` is read: two plain sites (the plane write, the plane read), the row writes, the part
-- writes (two per row), the cell reads
#guard (gen_d3s.pdesign.summary.toOption.map fun s => s.lsites.length) == some 6

/-- `(z, q)` of `gen_d3s` at width `N` for the input `a` (the values Icarus prints). -/
def d3sSpec (N a : Nat) : Nat × Nat :=
  let plane (s : Nat) := a / 2 ^ (12 * s) % 4096
  let T (s : Nat) := (List.range (s + 1)).foldl (fun acc j => acc ^^^ plane j) 0
  let swap (p : Nat) := (List.range 3).foldl (fun acc k =>
    let row := p / 2 ^ (4 * k) % 16
    acc + ((row % 4) * 4 + row / 4) * 2 ^ (4 * k)) 0
  let U := swap (T (N - 1))
  (U ^^^ T 0, U)

/-- The inputs the oracle bench drives at width `N` (the `k`-th, `k < m`). -/
def d3sIn (N k : Nat) : Nat :=
  ((k * 2654435761) ^^^ (k * 2 ^ 7) ^^^ (k * 2 ^ 19) ^^^ (k * 2 ^ 30)) % 2 ^ (12 * N)

/-- The first `m` bench inputs at width `N` (a test, evaluated by the compiler). -/
def d3sCheck (σ : ScheduleOracle) (N m : Nat) : Bool :=
  (List.range m).all fun k =>
    let a := d3sIn N k
    match run2 (gen_d3s.sem N) σ 64 [[("a", LVec.ofNat (12 * N) a)]] with
    | .ok [st] => SvState.lookup st "z" == some (LVec.ofNat 12 (d3sSpec N a).1) &&
        SvState.lookup st "q" == some (LVec.ofNat 12 (d3sSpec N a).2)
    | _ => false

#guard [1, 2, 3].all fun N => d3sCheck σ_src N 64
#guard [1, 2, 3].all fun N => d3sCheck σ_rev N 64

/-- Every input of `gen_d3p` at width `N`: `y` is bit `3(N-1) + 2` of `a` (a test, evaluated by the compiler). -/
def d3pCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (3 * N))).all fun a =>
    match run2 (gen_d3p.sem N) σ 64 [[("a", LVec.ofNat (3 * N) a)]] with
    | .ok [st] => SvState.lookup st "y" == some (LVec.ofNat 1 (a / 2 ^ (3 * (N - 1) + 2) % 2))
    | _ => false

#guard [1, 2, 3].all (d3pCheck σ_src)
#guard [1, 2, 3].all (d3pCheck σ_rev)

end Examples.«system-verilog».gen_d3s.gen
