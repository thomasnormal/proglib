import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_tern`: a power of a genvar in a loop bound, as `sv_comb` test subjects

`3 ** l` of a genvar `l` is read as the power atom `3 ^ l` (`XAt.pow 3 "l"`) of the affine reading, here in the bound of
the inner loop of a ternary tree (`t < 3**l`, the shape of `kara_lv`'s node loops). The instantiation evaluates the bound
over the integers (`evalInt`); it agrees with the atom's value, and with IEEE 1800-2023's 32-bit `int` meaning (§11.4.3),
exactly where the atom is in its range (`XAt.Ok`: `0 ≤ l < 32`, `3 ^ l < 2^31`), an obligation (`Summary.XObl`).

* `gen_tern.sv`: level `l` of the tree holds `3 ** l` nodes, each the XOR of its three children; `T = 3 ** N` leaves;
* `neg/gen_tern_sum.sv`: `3 ** (l + 1)`: a power whose exponent is a sum is not an atom, refused.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_tern/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_tern.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_tern from "Examples/system-verilog/gen_tern/gen_tern.sv.json"
load_design_sv2 gen_tern_sum from "Examples/system-verilog/gen_tern/neg/gen_tern_sum.sv.json"

-- The loops and their bounds' atoms: the leaves' bound is the localparam `T` (a named constant), the node loop's `3 ** l`.
#guard (gen_tern.pdesign.summary.toOption.map fun s => s.hdrSteps.map fun q => (q.2.g, q.2.bound.xs)) ==
  some [("t", []), ("l", []), ("t", [(1, .pow 3 "l")])]

-- The instantiation at `N = 3` builds 27 leaves, 1 + 3 + 9 nodes and the output: the closed-form list has the same
-- length.
#guard ((gen_tern.pdesign.instantiate2 [3] (PDesign.surfaceFuel [3])).toOption.map fun m => m.processes.size) == some 41
#guard (gen_tern.pdesign.summary.toOption.map fun s => (s.insts (s.val [3])).length) == some 41

-- The generate fuel (`PDesign.surfaceFuel [N] = (N + 2)² + 64` iterations per loop) holds the `3 ^ N` leaves up to
-- `N = 4` (`3^4 = 81 < 100`); at `N = 5` (`3^5 = 243 > 113`) the instantiation runs out of fuel and the family is one
-- loud process: the comb theorems are stated where the loop counts are within the fuel.
#guard ((gen_tern.pdesign.instantiate2 [4] (PDesign.surfaceFuel [4])).toOption.isSome,
    (gen_tern.pdesign.instantiate2 [5] (PDesign.surfaceFuel [5])).toOption.isSome) == (true, false)

-- The node loop's bound `3 ** l` as the instantiation evaluates it (`evalInt`) and as the summary's form does, against
-- Icarus Verilog 13.0's `pow3 l=…` (tac4/icarus/tb_pow.sv).
#guard (gen_tern.pdesign.summary.toOption.bind fun s => (gen_tern.pdesign.paramEnv2 [3]).toOption.bind fun e =>
    match s.hdrSteps with
    | [_, _, (_, h)] =>
        some (([0, 1, 2] : List Int).map fun l =>
          ((evalInt (e.bindVal "l" l) h.bndE).toOption, h.bound.eval (bindσ "l" l (s.val [3]))))
    | _ => none) ==
  some [(some 1, 1), (some 3, 3), (some 9, 9)]

end Examples.«system-verilog».gen_tern.gen
