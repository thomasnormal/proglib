import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_clog2q`: `$clog2` of a quotient, and a power of it, in localparams, as `sv_comb` test subjects

The parameter stage of the comb tactics (`closeParamEnv`, CombViewTactic.lean) evaluates the instantiation's 32-bit
`int` localparams at a symbolic parameter. `$clog2` of a quotient (IEEE 1800-2023 §20.8.1, §11.4.2) is evaluated at the
argument's own type, so its divisor is a converted literal and the argument, a quotient, is read as unsigned:

* `gen_clog2q.sv`: `NI = $clog2((N + 9) / 8) + 1` (the Newton step count of a Newton-Raphson divider) in a generate
  condition: the low `NI` bits of `a` pass to `q`;
* `gen_ktree.sv`: `L = $clog2((N + 3) / 4)`, `T = 3 ** L` (a Karatsuba multiplier's level structure): `T` leaves and
  `3 ** l` nodes per level;
* `neg/gen_clog2q_neg.sv`: `$clog2((N - 20) / 8)`, an argument that is negative for `N ≤ 12` (`-2` at `N ≤ 4`, `-1` at
  `5 ≤ N ≤ 12`: `/` truncates toward zero, IEEE 1800-2023 §11.4.2), which `$clog2` reads as unsigned (§20.8.1);
* `neg/gen_clog2q_div.sv`: `$clog2((N + 9) / D)`, a quotient by a parameter: refused by the recognizer.

Oracle: Icarus Verilog 12.0 (stable), a testbench outside the repository (`tb_clog2q.sv`), prints `NI`, `L`, `T` of an
instance of each design at each `N` through its hierarchical names; the tables below are its output. For
`gen_clog2q_neg` at `N ≤ 12` Icarus prints `NI = 33`: IEEE 1800-2023 §20.8.1 reads `$clog2`'s argument as unsigned, so
`$clog2(-1)` and `$clog2(-2)` of the 32-bit `int` quotient are `32`; the instantiation reads it so too (`evalAt`,
Param.lean).

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_clog2q/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_clog2q.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_clog2q from "Examples/system-verilog/gen_clog2q/gen_clog2q.sv.json"
load_design_sv2 gen_ktree from "Examples/system-verilog/gen_clog2q/gen_ktree.sv.json"
load_design_sv2 gen_clog2q_neg from "Examples/system-verilog/gen_clog2q/neg/gen_clog2q_neg.sv.json"
load_design_sv2 gen_clog2q_div from "Examples/system-verilog/gen_clog2q/neg/gen_clog2q_div.sv.json"

/-- `NI` of `gen_clog2q` at `N = 1, 2, …, 130`, Icarus Verilog 12.0's output. -/
def icarusNI : List Int :=
  List.replicate 6 1 ++ List.replicate 8 2 ++ List.replicate 16 3 ++ List.replicate 32 4 ++ List.replicate 64 5 ++
    List.replicate 4 6

/-- `NI` of `gen_clog2q_neg` at `N = 1, 2, …, 30`, Icarus Verilog 12.0's output: `33` where the quotient is negative. -/
def icarusNegNI : List Int :=
  List.replicate 12 33 ++ List.replicate 18 1

/-- `L` of `gen_ktree` at `N = 1, 2, …, 64`, Icarus Verilog 12.0's output (`T = 3 ** L` there too). -/
def icarusL : List Int :=
  List.replicate 4 0 ++ List.replicate 4 1 ++ List.replicate 8 2 ++ List.replicate 16 3 ++ List.replicate 32 4

/-- A localparam's 32-bit value in the instantiation environment at the arguments `args`. -/
def lpAt (pd : PDesign) (args : List Int) (n : String) : Option Int :=
  match pd.paramEnv2 args with
  | .ok e => e.intVal? n
  | _ => none

-- The instantiation and the summary against Icarus: `NI` at every `N ≤ 130`, `L` and `T` at every `N ≤ 64`.
#guard (List.range 130).map (fun (n : Nat) => lpAt gen_clog2q.pdesign [(n + 1 : Int)] "NI") == icarusNI.map some
#guard (gen_clog2q.pdesign.summary.toOption.map fun s => (List.range 130).map fun (n : Nat) => s.val [(n + 1 : Int)] "NI") ==
  some icarusNI
#guard (List.range 64).map (fun (n : Nat) => (lpAt gen_ktree.pdesign [(n + 1 : Int)] "L", lpAt gen_ktree.pdesign [(n + 1 : Int)] "T"))
  == icarusL.map fun l => (some l, some (3 ^ l.toNat))
#guard (gen_ktree.pdesign.summary.toOption.map fun s => (List.range 64).map fun (n : Nat) =>
    (s.val [(n + 1 : Int)] "L", s.val [(n + 1 : Int)] "T")) == some (icarusL.map fun l => (l, 3 ^ l.toNat))

-- `gen_clog2q_neg`: the instantiation and the summary read the negative quotient at `N ≤ 12` as unsigned (`NI = 33`)
-- and agree with Icarus at every `N ≤ 30`.
#guard (List.range 30).map (fun (n : Nat) => lpAt gen_clog2q_neg.pdesign [(n + 1 : Int)] "NI") == icarusNegNI.map some
#guard (gen_clog2q_neg.pdesign.summary.toOption.map fun s => (List.range 30).map fun (n : Nat) => s.val [(n + 1 : Int)] "NI")
  == some icarusNegNI

-- At `N = 9` the tree has `T = 9` leaves, `1 + 3` nodes and the output: as many processes as the summary's instances.
#guard ((gen_ktree.pdesign.instantiate2 [9] (PDesign.surfaceFuel [9])).toOption.map fun m => m.processes.size) == some 14
#guard (gen_ktree.pdesign.summary.toOption.map fun s => (s.insts (s.val [9])).length) == some 14

/-- Every input at width `N`: `q` holds the low `NI` bits of `a` (a test, evaluated by the compiler). -/
def clog2qExhaustive (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a =>
    match run2 (gen_clog2q.sem N) σ 64 [[("a", LVec.ofNat N a)]] with
    | .ok [st] => SvState.lookup st "q" == some (LVec.ofNat N (a % 2 ^ (clog2 ((N + 9) / 8) + 1)))
    | _ => false

#guard [1, 2, 3, 7, 8].all (clog2qExhaustive σ_src)
#guard [1, 2, 3, 7, 8].all (clog2qExhaustive σ_rev)

/-- Every input at width `N`: `y` is `a[0]` (the XOR of the `3 ** L` copies of it, an odd number). -/
def ktreeExhaustive (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a =>
    match run2 (gen_ktree.sem N) σ 64 [[("a", LVec.ofNat N a)]] with
    | .ok [st] => SvState.lookup st "y" == some (LVec.ofNat 1 (a % 2))
    | _ => false

#guard [1, 5, 9].all (ktreeExhaustive σ_src)
#guard [1, 5, 9].all (ktreeExhaustive σ_rev)

end Examples.«system-verilog».gen_clog2q.gen
