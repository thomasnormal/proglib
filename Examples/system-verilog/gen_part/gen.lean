import LeanModels.Sv.Ingest2
import LeanModels.Sv.CombView

/-!
# `gen_part`: indexed part selects `+:` and `-:`, as `sv_comb` test subjects

IEEE 1800-2023 §11.5.1: `x[b +: w]` selects the `w` bits from `b` up, `x[b -: w]` the `w` bits from `b` down. The summary
reads an indexed part select as the access of the range part select with the same bounds (`partRange`:
`[(b + w) - 1 : b]`, `[b : (b - w) + 1]`), the instantiation's own labels (`partLabels`, a width `w ≤ 0` refused); the
comb theorems prove the two windows equal over a zero-based descending dimension (`arrayPartGeom_part1`,
`arrayPartGeom_part2`, CombViewThm.lean).

* `gen_part.sv`: `+:` targets on a row of a 2-D array and on a vector, a `-:` target, `+:` reads of a row and a vector;
* `neg/gen_part_sq.sv`: a base `i*i` that is not affine, refused naming the select.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_part/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_part.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_part from "Examples/system-verilog/gen_part/gen_part.sv.json"
load_design_sv2 gen_part_sq from "Examples/system-verilog/gen_part/neg/gen_part_sq.sv.json"

-- The accesses of the sites: the `+:` and `-:` selects read as range parts with the bounds `partRange` gives.
#guard (gen_part.pdesign.summary.toOption.map fun s => s.lsites.map fun ls =>
    (ls.site.tgt.name, ls.site.rds.map Acc.name)) ==
  some [("g", ["a", "b"]), ("w", ["g"]), ("y", ["w"]), ("z", ["g", "w"])]

-- At `N = 3` the instantiation builds 2 * 3 + 3 * 3 processes, as many as the summary's instances.
#guard ((gen_part.pdesign.instantiate2 [3] (PDesign.surfaceFuel [3])).toOption.map fun m => m.processes.size) == some 15
#guard (gen_part.pdesign.summary.toOption.map fun s => (s.insts (s.val [3])).length) == some 15

-- The windows: at `N = 3`, the summary's window of every instance is the slice the instantiation's process writes.
#guard (gen_part.pdesign.summary.toOption.bind fun s =>
    (gen_part.pdesign.instantiate2 [3] (PDesign.surfaceFuel [3])).toOption.map fun m =>
      (s.insts (s.val [3])).map (·.tgt) == m.processes.toList.filterMap fun
        | .assign t _ => some t
        | _ => none) == some true

/-- Every input combination at width `N`: `y` interleaves `a` (odd bits) and `b` (even bits), `z = a ^ b` (a test,
evaluated by the compiler). -/
def partExhaustive (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (2 * N))).all fun k =>
    let a := k % 2 ^ N
    let b := k / 2 ^ N
    let y := (List.range N).foldl (fun acc i => acc + a / 2 ^ i % 2 * 2 ^ (2 * i + 1) + b / 2 ^ i % 2 * 2 ^ (2 * i)) 0
    match run2 (gen_part.sem N) σ 64 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b)]] with
    | .ok [st] =>
        SvState.lookup st "y" == some (LVec.ofNat (2 * N) y) &&
          SvState.lookup st "z" == some (LVec.ofNat N (Nat.xor a b))
    | _ => false

#guard [1, 2, 3].all (partExhaustive σ_src)
#guard [1, 2, 3].all (partExhaustive σ_rev)

end Examples.«system-verilog».gen_part.gen
