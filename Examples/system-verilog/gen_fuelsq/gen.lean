import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_fuelsq`: a loop count above the linear part of the generate fuel, as an `sv_comb` test subject

`for (i = 0; i < P; i++)` with `P = 4 * 2**L`, `L = $clog2(N + 1)`: the count is up to `8N + 4` (`2^L < 2(N + 1)`), and
`AutoObl` owes every count at most the instantiation's fuel, `fuelSq N + 4N + 67` (`N² + 4N + 67`). The bound holds at
every `N` because `N² ≥ 4N - 4` (`(N - 2)² ≥ 0`): the tangent facts `2·a·N ≤ fuelSq N + a²` (`fuelSq_tangent`, tac7) put it
in reach of `omega`. (tac6's wall W4 at `N < 2^28`.)

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_fuelsq Examples/system-verilog/gen_fuelsq/gen_fuelsq.sv -o gen_fuelsq.sv.json`.
-/

namespace Examples.«system-verilog».gen_fuelsq.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_fuelsq from "Examples/system-verilog/gen_fuelsq/gen_fuelsq.sv.json"

#guard (gen_fuelsq.pdesign.summary.toOption).isSome

/-- `s = a ^ b` and `cout = cin` at width `N`, for every input (a test, evaluated by the compiler). -/
def fuelsqCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (2 * N + 1))).all fun k =>
    let a := k % 2 ^ N
    let b := k / 2 ^ N % 2 ^ N
    let c := k / 2 ^ (2 * N)
    match run2 (gen_fuelsq.sem N) σ 256 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b), ("cin", LVec.ofNat 1 c)]] with
    | .ok [st] =>
        SvState.lookup st "s" == some (LVec.ofNat N (Nat.xor a b)) && SvState.lookup st "cout" == some (LVec.ofNat 1 c)
    | _ => false

#guard [1, 2, 3].all (fuelsqCheck σ_src)
#guard [1, 2, 3].all (fuelsqCheck σ_rev)

end Examples.«system-verilog».gen_fuelsq.gen
