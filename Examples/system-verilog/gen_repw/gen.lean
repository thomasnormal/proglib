import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_repw`: replications of a whole signal, as an `sv_comb` test subject

A replication `{c{x}}` of a WHOLE signal `x` (a port, an internal signal, a scalar or a vector) is read now: the width
of a replicated part is its window's (`Part.wid`), the declared width for a whole signal. Before, the fragment
replicated a sized literal, a bit select or a part select only (W9's restriction, "replicate a bit or a part select").

* `gen_repw.sv`: `{(P >> l){cin}}` (a 1-bit port, a count with a shift atom), `{(P >> 2){d}}` (a 2-bit port, `N` copies),
  `{2{a}}` (an `N`-bit port, a literal count), `P = 4N`.

Oracle: Icarus Verilog 12.0 (stable), a testbench outside the repository (`tb_repw.sv`), every input at `N = 1..4`
(240 rows):
`y0`, `y1`, `y2` agree with `repwSpec` below on every row; `repwCheck` checks the model against `repwSpec`.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_repw Examples/system-verilog/gen_repw/gen_repw.sv -o Examples/system-verilog/gen_repw/gen_repw.sv.json`.
-/

namespace Examples.«system-verilog».gen_repw.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_repw from "Examples/system-verilog/gen_repw/gen_repw.sv.json"

-- the three replications are read (the whole signals `cin`, `d`, `a`)
#guard (gen_repw.pdesign.summary.toOption.map fun s => s.lsites.length) == some 5

/-- `(y0, y1, y2)` of `gen_repw` at width `N` for the inputs `a`, `cin`, `d` (the values Icarus prints). -/
def repwSpec (N a cin d : Nat) : Nat × Nat × Nat :=
  let ones (k : Nat) := (List.range k).foldl (fun acc i => acc + cin * 2 ^ i) 0
  let hi := (List.range N).foldl (fun acc j => acc + d * 4 ^ j) 0
  (ones (4 * N), ones (2 * N) + hi * 2 ^ (2 * N), a + a * 2 ^ N)

/-- Every input at width `N` (a test, evaluated by the compiler). -/
def repwCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (N + 3))).all fun k =>
    let a := k % 2 ^ N
    let cin := k / 2 ^ N % 2
    let d := k / 2 ^ (N + 1)
    match run2 (gen_repw.sem N) σ 64
        [[("a", LVec.ofNat N a), ("cin", LVec.ofNat 1 cin), ("d", LVec.ofNat 2 d)]] with
    | .ok [st] =>
        let (y0, y1, y2) := repwSpec N a cin d
        SvState.lookup st "y0" == some (LVec.ofNat (4 * N) y0) &&
          SvState.lookup st "y1" == some (LVec.ofNat (4 * N) y1) &&
          SvState.lookup st "y2" == some (LVec.ofNat (2 * N) y2)
    | _ => false

#guard [1, 2, 3].all (repwCheck σ_src)
#guard [1, 2, 3].all (repwCheck σ_rev)

end Examples.«system-verilog».gen_repw.gen
