import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_tercg`: `?:` operands of generate-if conditions, as an `sv_comb` test subject (tac8)

A generate-if condition compares two operands; since tac8 an operand may be a `?:` whose condition compares two operands
and whose arms are operands (`opdAffs?`: one conditional atom, `XAt.cond`). The instantiation evaluates the condition at
the signed 32-bit type (`evalGenGuard`, `evalAt`): the `?:`'s own condition at its operands' type, only the chosen arm at
the context (IEEE 1800-2023 §11.4.11); `opd_eval` shows that is the atom's value where every subterm is a 32-bit value.

* `gen_tercg.sv`: `if (k < ((N > 2) ? N - 2 : 0))` (a `?:` of the parameter) chooses `y[k] = a[k + 1]` or `a[k]`, and
  `if (k >= ((k < 2) ? k : N - 1))` (a `?:` of the genvar) chooses `z[k] = b[k]` or `~b[k]`.

Oracle: Icarus Verilog 12.0 (stable), `tac8/icarus/tb_tercg.sv` of the round's notes, every input at `N = 1..5` (1364
rows): `y` and `z` agree with `tercgSpec` below on every row; `tercgCheck` checks the model against `tercgSpec`.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_tercg Examples/system-verilog/gen_tercg/gen_tercg.sv -o Examples/system-verilog/gen_tercg/gen_tercg.sv.json`.
-/

namespace Examples.«system-verilog».gen_tercg.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_tercg from "Examples/system-verilog/gen_tercg/gen_tercg.sv.json"

-- the four arms are read, each under a guard with one conditional atom
#guard (gen_tercg.pdesign.summary.toOption.map fun s => s.lsites.length) == some 4

/-- `(y, z)` of `gen_tercg` at width `N` for the inputs `a`, `b` (the values Icarus prints). -/
def tercgSpec (N a b : Nat) : Nat × Nat :=
  (List.range N).foldl (fun (yz : Nat × Nat) k =>
    let lo := if N > 2 then N - 2 else 0
    let yk := if k < lo then a / 2 ^ (k + 1) % 2 else a / 2 ^ k % 2
    let thr := if k < 2 then k else N - 1
    let zk := if k ≥ thr then b / 2 ^ k % 2 else 1 - b / 2 ^ k % 2
    (yz.1 + yk * 2 ^ k, yz.2 + zk * 2 ^ k)) (0, 0)

/-- Every input at width `N` (a test, evaluated by the compiler). -/
def tercgCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (2 * N))).all fun k =>
    let a := k % 2 ^ N
    let b := k / 2 ^ N
    match run2 (gen_tercg.sem N) σ 64 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b)]] with
    | .ok [st] =>
        let (y, z) := tercgSpec N a b
        SvState.lookup st "y" == some (LVec.ofNat N y) && SvState.lookup st "z" == some (LVec.ofNat N z)
    | _ => false

#guard [1, 2, 3, 4].all (tercgCheck σ_src)
#guard [1, 2, 3, 4].all (tercgCheck σ_rev)

end Examples.«system-verilog».gen_tercg.gen
