import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_start`: generate loops whose start is not an integer literal, as an `sv_comb` test subject

IEEE 1800-2023 §27.4: the initialization of a loop generate scheme is a constant expression, evaluated once before the
first iteration; the instantiation evaluates it with `evalInt`, as it does a bound (`GenItem.expand2`). The summary reads
a start that is not an integer literal by `affOf?` (a linear form of the parameters and the enclosing genvars, quotient,
shift and power atoms, a `?:` as one conditional atom: `Hdr.st`), and `affOf?_sound` says the instantiation's value is
the reading's (`Hdr.evalInt_initE`). Before, every such loop was refused ("generate-for header outside
`for (g = <int>; …)`").

* `gen_start.sv`: a start that is a parameter expression (`for (i = N - N / 2; i < N; i++)`: `y[i]` is
  `a[i] ^ b[i - h]` from `i = h = N - N / 2` on, `a[i] & b[i]` below), a start that is the enclosing genvar plus one
  (`for (k = j + 1; k < N; k++)`: row `j` of `t` is `a[j] & b[k]` right of the diagonal, `a[k] ^ b[j]` on and left of
  it), and a `?:` start of a one-iteration loop, the form of the Dadda record
  (`for (k = (j < (N >> 1)) ? N - 1 - j : j; k < (…) + 1; k++)`: `z[j] = a[k]`).

Oracle: Icarus Verilog 12.0 (stable), the round's bench `tb_start.sv`, every input pair at `N = 1..4` (340 rows): the
three outputs are the formulas of `startSpec` on every row; `startCheck` checks the model against the same.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_start Examples/system-verilog/gen_start/gen_start.sv -o Examples/system-verilog/gen_start/gen_start.sv.json`.
-/

namespace Examples.«system-verilog».gen_start.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_start from "Examples/system-verilog/gen_start/gen_start.sv.json"

-- every loop is read, the three starts among them: the sites of `g_hi`, `g_lo`, `g_up`, `g_dn`, `g_k`
#guard (gen_start.pdesign.summary.toOption.map fun s => s.lsites.length) == some 5

/-- `(y, t, z)` of `gen_start` at width `N` for the inputs `a`, `b` (the values Icarus prints). -/
def startSpec (N a b : Nat) : Nat × Nat × Nat :=
  let bit (v i : Nat) := v / 2 ^ i % 2
  let h := N - N / 2
  let y := (List.range N).foldl (fun acc i =>
    acc + (if h ≤ i then (bit a i + bit b (i - h)) % 2 else bit a i * bit b i) * 2 ^ i) 0
  let t := (List.range N).foldl (fun acc j => (List.range N).foldl (fun acc k =>
    acc + (if j < k then bit a j * bit b k else (bit a k + bit b j) % 2) * 2 ^ (j * N + k)) acc) 0
  let z := (List.range N).foldl (fun acc j => acc + bit a (if j < N / 2 then N - 1 - j else j) * 2 ^ j) 0
  (y, t, z)

/-- Every input pair at width `N` (a test, evaluated by the compiler). -/
def startCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a => (List.range (2 ^ N)).all fun b =>
    match run2 (gen_start.sem N) σ 64 [[("a", LVec.ofNat N a), ("b", LVec.ofNat N b)]] with
    | .ok [st] => SvState.lookup st "y" == some (LVec.ofNat N (startSpec N a b).1) &&
        SvState.lookup st "t" == some (LVec.ofNat (N * N) (startSpec N a b).2.1) &&
        SvState.lookup st "z" == some (LVec.ofNat N (startSpec N a b).2.2)
    | _ => false

#guard [1, 2, 3, 4].all (startCheck σ_src)
#guard [1, 2, 3, 4].all (startCheck σ_rev)

end Examples.«system-verilog».gen_start.gen
