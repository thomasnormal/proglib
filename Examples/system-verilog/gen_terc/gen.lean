import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_terc`: `?:` of the parameters and genvars in an index and in a loop bound, as an `sv_comb` test subject (tac8)

A `?:` whose condition compares two linear forms and whose arms are linear forms, `>>` of a name by a literal or further
`?:`, is read as one conditional atom (`XAt.cond`, a `CL`; `clOf?`) wherever an affine form is read with `evalInt`; the
instantiation evaluates it exactly (only the chosen arm, the comparison on unbounded integers), and `clOf?_sound` says it
is the atom's value. Until tac8 every `?:` in an index or a bound was refused.

* `gen_terc.sv`: `y[k] = a[(k == 0) ? N - 1 : k - 1]` (`y` is `a` rotated up by one) and `z[j] = a[j + 1]` for
  `j < ((N > 1) ? N - 1 : 0)`, with `z[N-1] = a[0]` (`z` is `a` rotated down by one; no loop iteration at `N = 1`).

Oracle: Icarus Verilog 12.0 (stable), `tac8/icarus/tb_terc.sv` of the round's notes, every input at `N = 1..6` (126 rows):
`y` and `z` are the two rotations on every row; `tercCheck` checks the model against the same.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_terc Examples/system-verilog/gen_terc/gen_terc.sv -o Examples/system-verilog/gen_terc/gen_terc.sv.json`.
-/

namespace Examples.«system-verilog».gen_terc.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_terc from "Examples/system-verilog/gen_terc/gen_terc.sv.json"

-- the index and the loop bound are read, each with one conditional atom
#guard (gen_terc.pdesign.summary.toOption.map fun s => s.lsites.length) == some 3

/-- Every input at width `N`: `y` is `a` rotated up by one and `z` rotated down (a test, evaluated by the compiler). -/
def tercCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ N)).all fun a =>
    let up := (a * 2 + a / 2 ^ (N - 1)) % 2 ^ N
    let dn := (a / 2 + (a % 2) * 2 ^ (N - 1)) % 2 ^ N
    match run2 (gen_terc.sem N) σ 64 [[("a", LVec.ofNat N a)]] with
    | .ok [st] => SvState.lookup st "y" == some (LVec.ofNat N up) && SvState.lookup st "z" == some (LVec.ofNat N dn)
    | _ => false

#guard [1, 2, 3, 4].all (tercCheck σ_src)
#guard [1, 2, 3, 4].all (tercCheck σ_rev)

end Examples.«system-verilog».gen_terc.gen
