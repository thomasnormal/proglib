import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_pow`: shift and power atoms of the genvars, as `sv_comb` test subjects

`1 << l` of a genvar `l` is read as a POWER ATOM of the affine reading (`XAt.pow 2 "l"`, `Aff.xs`): in a generate
condition (`i >= (1 << l)`, `opdAffs?`), in a loop bound (`i < (1 << l)`, `hdrOf?`) and in an index
(`x[l][i - (1 << l)]`, `affOf?`). The instantiation evaluates a condition at the signed 32-bit type (`evalGenGuard`) and a
bound or an index over the integers (`evalInt`); both agree with the atom's value, and with IEEE 1800-2023's 32-bit
`int` meaning of the shift (§11.4.10, §27.4), exactly where the atom is in its range (`XAt.Ok`: `0 ≤ l < 32`,
`2 ^ l < 2^31`), an obligation (`Summary.XObl`).

* `gen_pow.sv`: a Kogge-Stone-style OR prefix (`x`, a condition and an index with `1 << l`) and a triangle (`t`, a
  bound `1 << l`), `L = $clog2(N)` levels;
* `neg/gen_pow_two.sv`: `(2 << l) - 2` in an index: `c << l` is an atom only for `c = 1`, refused;
* `neg/gen_pow_amt.sv`: `1 << (l + 1)` in a condition: a shift by a sum is not an atom, refused;
* `neg/gen_pow_decl.sv`: `1 << N` in a declared bound: declarations stay atom-free, refused;
* `neg/gen_pow_wide.sv`: `(1 << l) > 0` over every `l < N`: read; the atom's range is owed at every `l`, which holds
  under `N ≤ 31` and is false under `N < 2^31 - 1`.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_pow/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_pow.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_pow from "Examples/system-verilog/gen_pow/gen_pow.sv.json"
load_design_sv2 gen_pow_two from "Examples/system-verilog/gen_pow/neg/gen_pow_two.sv.json"
load_design_sv2 gen_pow_amt from "Examples/system-verilog/gen_pow/neg/gen_pow_amt.sv.json"
load_design_sv2 gen_pow_decl from "Examples/system-verilog/gen_pow/neg/gen_pow_decl.sv.json"
load_design_sv2 gen_pow_wide from "Examples/system-verilog/gen_pow/neg/gen_pow_wide.sv.json"

-- The located sites: blocks, positions (the arms numbered in the loop's block) and the guards of their arms.
#guard (gen_pow.pdesign.summary.toOption.map fun s => s.lsites.map fun ls =>
    (ls.blk, ls.site.pos, ls.hdrs.map fun h => (h.g, h.gs.map (·.2)))) ==
  some [("g_in", 0, [("i", [])]), ("g_node", 0, [("l", []), ("i", [true])]),
        ("g_node", 1, [("l", []), ("i", [false])]), ("g_tri", 0, [("l", []), ("i", [])]), ("g_out", 0, [("i", [])])]

-- The atoms the summary reads: the condition's operand `1 << l`, the triangle's bound, the read index `i - (1 << l)`.
#guard (gen_pow.pdesign.summary.toOption.map fun s =>
    (s.condSteps.map fun c => c.2.2.b.xs, s.hdrSteps.map fun q => q.2.bound.xs, !s.atomFree)) ==
  some ([[(1, .pow 2 "l")]], [[], [], [], [(1, .pow 2 "l")], []], true)

-- The instantiation at `N = 5` (`L = 3`) builds 5 + 3 * 5 + (1 + 2 + 4) + 5 processes, one per iteration and arm: the
-- closed-form list of the summary has the same length.
#guard ((gen_pow.pdesign.instantiate2 [5] (PDesign.surfaceFuel [5])).toOption.map fun m => m.processes.size) == some 32
#guard (gen_pow.pdesign.summary.toOption.map fun s => (s.insts (s.val [5])).length) == some 32

-- The arm the instantiation selects (`evalGenGuard` of `i >= (1 << l)` at the environment of `N = 5` with the genvars
-- bound) and the summary's guard (`Guard.holds` at the summary's valuation) agree with the values Icarus Verilog 13.0
-- prints for the same condition over the same genvars (`iverilog -g2012`, tb_pow.sv: `cond l=… i=…`).
#guard (gen_pow.pdesign.summary.toOption.bind fun s => (gen_pow.pdesign.paramEnv2 [5]).toOption.bind fun e =>
    match s.condSteps with
    | [(_, c, g)] =>
        some (([0, 1, 2] : List Int).map fun l => ([0, 1, 2, 3, 4] : List Int).map fun i =>
          ((evalGenGuard ((e.bindVal "l" l).bindVal "i" i) c).toOption,
            decide (g.holds (bindσ "i" i (bindσ "l" l (s.val [5]))))))
    | _ => none) ==
  some [[(some 0, false), (some 1, true), (some 1, true), (some 1, true), (some 1, true)],
    [(some 0, false), (some 0, false), (some 1, true), (some 1, true), (some 1, true)],
    [(some 0, false), (some 0, false), (some 0, false), (some 0, false), (some 1, true)]]

-- The bound `1 << l` of the triangle and the index `i - (1 << l)` of the node's read, as the instantiation evaluates them
-- (`evalInt`) and as the summary's affine forms do, against Icarus Verilog's `bound l=…` and `idx l=… i=…`.
#guard (gen_pow.pdesign.summary.toOption.bind fun s => (gen_pow.pdesign.paramEnv2 [5]).toOption.bind fun e =>
    match s.hdrSteps with
    | [_, _, _, (_, h), _] =>
        some (([0, 1, 2] : List Int).map fun l =>
          ((evalInt (e.bindVal "l" l) h.bndE).toOption, h.bound.eval (bindσ "l" l (s.val [5]))))
    | _ => none) ==
  some [(some 1, 1), (some 2, 2), (some 4, 4)]
#guard (gen_pow.pdesign.summary.toOption.bind fun s => (gen_pow.pdesign.paramEnv2 [5]).toOption.bind fun e =>
    match s.lsites with
    | [_, op, _, _, _] =>
        match op.site.rds with
        | [_, .cell2 _ _ _ c] =>
            some (([0, 1, 2] : List Int).map fun l => ([0, 1, 2, 3, 4] : List Int).map fun i =>
              ((evalInt ((e.bindVal "l" l).bindVal "i" i)
                (.binary (.m0 .sub) (.genvarRef "i") (.binary .shl (.int 1) (.genvarRef "l")))).toOption,
                c.eval (bindσ "i" i (bindσ "l" l (s.val [5])))))
        | _ => none
    | _ => none) ==
  some [[(some (-1), -1), (some 0, 0), (some 1, 1), (some 2, 2), (some 3, 3)],
    [(some (-2), -2), (some (-1), -1), (some 0, 0), (some 1, 1), (some 2, 2)],
    [(some (-4), -4), (some (-3), -3), (some (-2), -2), (some (-1), -1), (some 0, 0)]]

-- At the edge of the 32-bit range (`gen_pow_wide`, `(1 << l) > 0`): at `l = 30` the instantiation, the summary's guard
-- and Icarus Verilog 13.0 agree (`wide l=30 pos`); at `l = 31` the instantiation wraps `1 << 31` to `-2^31` as IEEE's
-- `int` does (§11.4.10) and selects the `else` arm, as Icarus does (`wide l=31 neg -2147483648`), while the summary's
-- atom, read over the integers, is `2^31` and its guard holds: this is why the atom's range is owed (`XAt.Ok`,
-- `2 ^ l < 2^31`), and the tactics claim nothing there. At `l = 32` the shift gives `0` (Icarus `wide l=32 neg 0`).
#guard (gen_pow_wide.pdesign.summary.toOption.bind fun s => (gen_pow_wide.pdesign.paramEnv2 [40]).toOption.bind
    fun e => match s.condSteps with
      | [(_, c, g)] => some (([30, 31, 32] : List Int).map fun l => ((evalGenGuard (e.bindVal "l" l) c).toOption,
          decide (g.holds (bindσ "l" l (s.val [40]))), decide ((XAt.pow 2 "l").Ok (bindσ "l" l (s.val [40])))))
      | _ => none) == some [(some 1, true, true), (some 0, true, false), (some 0, true, false)]

-- The index reading (`evalInt`, over the integers) gives `2^31` at `l = 31`, not IEEE's `-2^31`, and refuses `l = 32`:
-- outside the atom's range neither reading is claimed.
#guard ((evalInt ({ vals := [("l", 31)] } : IEnv) (.binary .shl (.int 1) (.genvarRef "l"))).toOption,
    (evalInt ({ vals := [("l", 32)] } : IEnv) (.binary .shl (.int 1) (.genvarRef "l"))).toOption) ==
  (some 2147483648, none)

end Examples.«system-verilog».gen_pow.gen
