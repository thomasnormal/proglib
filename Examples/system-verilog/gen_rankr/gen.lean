import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_rankr`: a 2-D level chain at product slot bases, as an `sv_comb` test subject (tac8)

* `gen_rankr.sv`: row `l + 1` of `v` (`P = 2N` bits) is row `l` with its halves swapped, the halves at the slot bases
  `t*(P >> j)` and `(1-t)*(P >> j)` (products of a genvar and a shift atom); `y` is row 2, so `y = a`.

The test is of the RANK obligations (`comb_proof.lean`): each one reads the overlap of a read window of row `l` with a
written window of row `l' + 1`, two row-major windows whose columns are products; in the ranged form
(`set_option sv_comb.rank_ranged true`) the in-range facts of both windows are premises, and the goal closes by the
row-major lemmas and `omega` with no fact about the products.

Oracle: Icarus Verilog 12.0 (stable), `tac8/icarus/tb_rankr.sv` of the round's notes, every input at `N = 1..4` (340
rows): `y = a` on every row; `rankrCheck` checks the model against the same.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top gen_rankr Examples/system-verilog/gen_rankr/gen_rankr.sv -o Examples/system-verilog/gen_rankr/gen_rankr.sv.json`.
-/

namespace Examples.«system-verilog».gen_rankr.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_rankr from "Examples/system-verilog/gen_rankr/gen_rankr.sv.json"

-- the sites: the two plain assigns, then the level family `g_t` (three loops)
#guard (gen_rankr.pdesign.summary.toOption.map fun s => s.lsites.map fun ls => (ls.site.pos, ls.hdrs.length)) ==
  some [(0, 0), (1, 0), (0, 3)]

/-- Every input at width `N`: `y = a` (a test, evaluated by the compiler). -/
def rankrCheck (σ : ScheduleOracle) (N : Nat) : Bool :=
  (List.range (2 ^ (2 * N))).all fun a =>
    match run2 (gen_rankr.sem N) σ 64 [[("a", LVec.ofNat (2 * N) a)]] with
    | .ok [st] => SvState.lookup st "y" == some (LVec.ofNat (2 * N) a)
    | _ => false

#guard [1, 2, 3].all (rankrCheck σ_src)
#guard [1, 2, 3].all (rankrCheck σ_rev)

end Examples.«system-verilog».gen_rankr.gen
