import LeanModels.Sv.Ingest2
import LeanModels.Sv.Comb2
import LeanModels.Sv.CombTaskTactic
import LeanModels.Sv.CombProcTactic

/-!
# A design with module instances whose parent has two parameters, all four stages

`split_word.sv` splits a word at a parameter: the low `P` bits through one parameterized identity leaf, the high `W - P`
bits through another, the parent's `wire` output tiled by the two instances' output ports. The tactics read it through
its flat twin (`CombHier.lean`). Until this example the structure and equation proofs of such a design elaborated but
failed the kernel check ("deep recursion detected") as soon as the PARENT had two or more parameters, used or not: the
children's environment goal (`CombHier.AllChildEnvOk`) was rewritten open by `simp`/`unfold` over the parent's symbolic
environment. The tactics now build that goal by lemma application (`AllChildEnvOk.cons`, `ChildEnvOk.intro`,
`AllChildEnvOk.nil`), and the kernel check is instant.

* `split_word_spec`: for every `1 ≤ P < W` in the `int` range, the ports are `a` and `y` (`W` bits), no process
  is clocked, the design is its own lowering with a rank, every run terminates, and in every cycle whose stimulus
  drives `a` with a known `x : BitVec W`, `y = x`.

Oracle: Icarus Verilog 12.0 (stable), a testbench outside the repository (`tb_split_word.sv`): `(W, P)` in
`{(2, 1), (5, 2), (8, 3), (8, 7)}`, every input: `y = a` on all 548 rows.

The envelope was generated by `python3.12 extractors/sv/extract.py --top split_word
Examples/system-verilog/hier_params/split_word.sv -o split_word.sv.json`.
-/

open LeanModels.Sv LeanModels.Sv.CombView LeanModels.Sv.CombEq

namespace Examples.«system-verilog».hier_params.split_proof

load_design_sv2 split_word from "Examples/system-verilog/hier_params/split_word.sv.json"

-- A run at `W = 8`, `P = 3`: `a = 0xB4`, `y = 0xB4`.
#guard (match run2 (split_word.sem 8 3) σ_src 64 [[("a", .ofNat 8 0xB4)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "10110100"
  | _ => false)

theorem split_word_struct (W P : Nat) (hP : 1 ≤ P) (hPW : P < W) (hR : (W : Int) < 2147483647) :
    CombDesign (split_word.sem W P) ∧ Acyclic (split_word.sem W P) := by
  sv_structure (rank := rippleRank (fun p => if p % 3 = 1 then 2 else if p % 3 = 2 then 1 else 0) (fun _ _ _ => 0))
  all_goals (intros; omega)

theorem split_word_ports (W P : Nat) (hP : 1 ≤ P) (hPW : P < W) (hR : (W : Int) < 2147483647)
    (hc : CombDesign (split_word.sem W P)) :
    (split_word.sem W P).inputPorts = [("a", W)] ∧ (split_word.sem W P).outputPorts = [("y", W)] := by
  sv_interface

theorem split_word_spec (W P : Nat) (hP : 1 ≤ P) (hPW : P < W) (hR : (W : Int) < 2147483647) :
    ((split_word.sem W P).inputPorts = [("a", W)] ∧ (split_word.sem W P).outputPorts = [("y", W)]) ∧
      ((∀ p ∈ (split_word.sem W P).processes.toList, p.isEdgePhase = false) ∧
        (∃ d', (split_word.sem W P).lowerComb = some d' ∧ Acyclic d') ∧ Terminates2 (split_word.sem W P)) ∧
      split_word.sem W P ⊨₂ spec2 fun stim tr => ∀ (c : Nat) (inputs st : SvState),
        stim[c]? = some inputs → tr[c]? = some st →
        ∀ (x : BitVec W), SvState.lookup inputs "a" = some (LVec.ofBitVec x) →
          SvState.lookup st "y" = some (LVec.ofBitVec x) := by
  obtain ⟨hc, ha⟩ := split_word_struct W P hP hPW hR
  refine CombTask.of_comb hc ha (split_word_ports W P hP hPW hR hc) fun inputs st heqs hsh hin => ?_
  intro x hA
  sv_inputs
  sv_equations
  · -- the widths: the low leaf is `P` bits, the high one `W - P`, the word `W`
    have e1 : ((↑P : Int) + -1 + 1).toNat = P := by omega
    have e2 : ((↑W : Int) + -1 - ↑P + 1).toNat = W - P := by omega
    have e3 : ((↑W : Int) + -1).natAbs + 1 = W := by omega
    have e4 : ((↑P : Int) + -1).natAbs + 1 = P := by omega
    have e5 : ((↑W : Int) - ↑P + -1).natAbs + 1 = W - P := by omega
    simp only [e1, e2, e3, e4, e5] at eq_lo_a_1 eq_lo_y_1 eq_hi_a_1 eq_hi_y_1 eq_y_1 eq_y_2 known_y_1 known_y_2
    have hk : ∀ k, k < W → (∃ w, SvState.lookup st "y" = some w ∧ w.width = W) ∧ KnownBit st "y" k := by
      intro k hk
      by_cases h : k < P
      · exact known_y_1 k h
      · have := known_y_2 (k - P) (by omega)
        rwa [Nat.add_sub_cancel' (by omega)] at this
    rw [SvState.port_ofBitVec hk rfl (by omega)]
    congr 2
    apply BitVec.eq_of_getLsbD_eq
    intro i hi
    rw [XF.getLsbD_bv hi]
    by_cases h : i < P
    · -- the low part, through the leaf `lo`
      rw [eq_y_1 i h, eq_lo_y_1 i h, eq_lo_a_1 i h, bit_a i hi]
    · -- the high part, through the leaf `hi`
      obtain ⟨j, rfl⟩ : ∃ j, i = P + j := ⟨i - P, by omega⟩
      rw [eq_y_2 j (by omega), eq_hi_y_1 j (by omega), eq_hi_a_1 j (by omega), bit_a (P + j) hi]
  sv_obligations

/-! ## Axioms -/

/--
info: 'Examples.«system-verilog».hier_params.split_proof.split_word_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms split_word_spec

end Examples.«system-verilog».hier_params.split_proof
