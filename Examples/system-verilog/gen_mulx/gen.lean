import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_mulx`: products of a genvar and a shift by an affine amount, as `sv_comb` test subjects

`m >> (n + c)` and `m >> (n - c)` of named constants `m`, `n` and an integer literal `c` are the atom `shrA m n c`
(`m / 2 ^ (n + c)`, owed in its range `XAt.Ok`: `0 ≤ m < 2^31`, `0 ≤ n + c < 32`), and the product of a form of names and
an atom form distributes into the product atoms `XAt.mul g x` (`g · x`, `affMul`, CombView.lean): kara's slot bases
`(3*t)*(P >> (l+1))`.

* `gen_mulx.sv`: `y[t*(P>>(l+1)) +: (P>>(l+1))] = a[(1-t)*(P>>(l+1)) +: …]` (a product with a negative coefficient), a
  generate condition `(N >> (l + 1)) == 0` choosing `z`'s arm, `a[(2*t)*(P >> (l+2)) +: …]`, and `q = a[(P >> (j - 1)) - 1]`
  (an amount `n - c`);
* `neg/gen_mulx_quot.sv`: `t * (P / 2)`, a genvar times a quotient: not read, refused (`comb_errors`);
* `neg/gen_mulx_amt.sv`: `P >> (l + t)`, a shift by the sum of two genvars: not an atom, refused (`comb_errors`).

Oracle: Icarus Verilog 12.0 (stable), `tac7/icarus/tb_mulx.sv` of the round's notes, every input at `N = 1..3`
(4368 rows): its `y`, `z` and `q` agree with `mulxSpec` below on every row; `mulxCheck` checks the model against
`mulxSpec` (every input at `N = 1, 2`, every 61st at `N = 3`).

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_mulx/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_mulx.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_mulx from "Examples/system-verilog/gen_mulx/gen_mulx.sv.json"
load_design_sv2 gen_mulx_quot from "Examples/system-verilog/gen_mulx/neg/gen_mulx_quot.sv.json"
load_design_sv2 gen_mulx_amt from "Examples/system-verilog/gen_mulx/neg/gen_mulx_amt.sv.json"

-- The accesses: the slot bases are product atoms, `P >> (l + 1)` and `P >> (j - 1)` the affine-amount atom.
#guard (gen_mulx.pdesign.summary.toOption.map fun s => s.lsites.map fun ls =>
    (ls.site.tgt.name, ls.site.rds.map Acc.name)) ==
  some [("y", ["a"]), ("z", ["b"]), ("z", ["a", "b"]), ("q", ["a"])]
#guard (gen_mulx_quot.pdesign.summary.toOption).isNone
#guard (gen_mulx_amt.pdesign.summary.toOption).isNone

/-- `y`, `z` and `q` of `gen_mulx` at width `N` for the inputs `a`, `b` (the values Icarus prints). -/
def mulxSpec (N a b : Nat) : Nat × Nat × Nat :=
  let bit (x i : Nat) := x / 2 ^ i % 2
  let S := 2 * N / 2
  let y := (List.range 2).foldl (fun acc t => (List.range S).foldl
    (fun acc i => acc + bit a ((1 - t) * S + i) * 2 ^ (t * S + i)) acc) 0
  let z := (List.range 2).foldl (fun acc t => (List.range S).foldl (fun acc i => acc +
    (if N / 2 = 0 then bit b (t * S + i) else Nat.xor (bit a (2 * t * (2 * N / 4) + i)) (bit b ((1 - t) * S + i))) *
      2 ^ (t * S + i)) acc) 0
  (y, z, bit a (2 * N - 1))

/-- Every input at width `N` whose index is a multiple of `step` (a test, evaluated by the compiler). -/
def mulxCheck (σ : ScheduleOracle) (step N : Nat) : Bool :=
  ((List.range (2 ^ (4 * N))).filter (· % step == 0)).all fun k =>
    let a := k % 2 ^ (2 * N)
    let b := k / 2 ^ (2 * N)
    match run2 (gen_mulx.sem N) σ 64 [[("a", LVec.ofNat (2 * N) a), ("b", LVec.ofNat (2 * N) b)]] with
    | .ok [st] =>
        SvState.lookup st "y" == some (LVec.ofNat (2 * N) (mulxSpec N a b).1) &&
          SvState.lookup st "z" == some (LVec.ofNat (2 * N) (mulxSpec N a b).2.1) &&
          SvState.lookup st "q" == some (LVec.ofNat 1 (mulxSpec N a b).2.2)
    | _ => false

#guard [1, 2].all (mulxCheck σ_src 1)
#guard [1, 2].all (mulxCheck σ_rev 1)
#guard mulxCheck σ_src 61 3
#guard mulxCheck σ_rev 61 3

end Examples.«system-verilog».gen_mulx.gen
